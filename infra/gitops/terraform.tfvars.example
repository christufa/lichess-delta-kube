# Copy to terraform.tfvars (gitignored).
subscription_id = "00000000-0000-0000-0000-000000000000"

# Same values as ../state.tfbackend (terraform -chdir=../bootstrap output)
state_resource_group_name  = "rg-<project>-tfstate"
state_storage_account_name = "st<project>tf<suffix>"

# Public entry (#45). Also set $env:CLOUDFLARE_API_TOKEN before plan/apply.
cloudflare_account_id = "<32 hex chars>"
cloudflare_zone_id    = "<32 hex chars>"
cloudflare_team_name  = "<team>"
access_allowed_emails = ["you@example.com"]

