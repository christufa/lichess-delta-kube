{
  "uid": "lichess-workflows",
  "title": "Lichess workflows",
  "tags": [
    "lichess",
    "argo-workflows"
  ],
  "description": "Argo Workflows runs, outcomes and run time per WorkflowTemplate, and the project's daily Azure cost (#31). Individual runs are in the Argo Workflows UI (link at the top).",
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "Argo Workflows (individual runs)",
      "type": "link",
      "icon": "external link",
      "url": "https://chess-flows.generops.dev/workflows/lichess",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "template",
        "label": "WorkflowTemplate",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "amp"
        },
        "query": {
          "query": "label_values(argo_workflows_workflowtemplate_triggered_total, name)",
          "refId": "template"
        },
        "definition": "label_values(argo_workflows_workflowtemplate_triggered_total, name)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Running",
      "description": "Workflows running right now.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(argo_workflows_gauge{phase=\"running\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Succeeded (24h)",
      "description": "Runs that succeeded in the last 24 hours.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(round(increase(argo_workflows_workflowtemplate_triggered_total{phase=\"succeeded\", name=~\"$template\"}[24h])))",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Failed (24h)",
      "description": "Runs that failed or errored in the last 24 hours. Each one also fires the WorkflowFailed alert.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(round(increase(argo_workflows_workflowtemplate_triggered_total{phase=~\"failed|error\", name=~\"$template\"}[24h])))",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Pods running",
      "description": "Pods the workflow controller runs (Spark's own driver and executor pods aren't counted).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(argo_workflows_pods_gauge{phase=\"running\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Pods pending",
      "description": "Workflow pods waiting for a node (spot capacity, quota).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(argo_workflows_pods_gauge{phase=\"pending\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Controller queue",
      "description": "Items waiting in the workflow controller's queues. Above 0 for long means it's falling behind.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(argo_workflows_queue_depth_gauge)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Runs finished, by outcome",
      "description": "Workflow runs that ended in each interval.",
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (phase) (round(increase(argo_workflows_workflowtemplate_triggered_total{phase=~\"succeeded|failed|error\", name=~\"$template\"}[$__interval])))",
          "refId": "A",
          "legendFormat": "{{phase}}",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Runs started, by template",
      "description": "Runs started from each WorkflowTemplate. spark-job covers every Spark build and maintenance run.",
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (name) (round(increase(argo_workflows_workflowtemplate_triggered_total{phase=\"new\", name=~\"$template\"}[$__interval])))",
          "refId": "A",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Run time",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Per template (selected time range)",
      "description": "Runs, failures and run time per WorkflowTemplate over the dashboard's time range. p90 comes from the controller's histogram, whose buckets stop at 7500 s: longer runs (backfills) count as over 7500 s.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (name) (round(increase(argo_workflows_workflowtemplate_runtime_count{name=~\"$template\"}[$__range])))",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (name) (round(increase(argo_workflows_workflowtemplate_triggered_total{phase=~\"failed|error\", name=~\"$template\"}[$__range])))",
          "refId": "B",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (name) (increase(argo_workflows_workflowtemplate_runtime_sum{name=~\"$template\"}[$__range])) / sum by (name) (increase(argo_workflows_workflowtemplate_runtime_count{name=~\"$template\"}[$__range]))",
          "refId": "C",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.9, sum by (le, name) (increase(argo_workflows_workflowtemplate_runtime_bucket{name=~\"$template\"}[$__range])))",
          "refId": "D",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Template",
              "Value #A": "Runs",
              "Value #B": "Failed",
              "Value #C": "Average run time",
              "Value #D": "p90 run time"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Runs",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Average run time|p90 run time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Average run time, by template",
      "interval": "1h",
      "description": "Average run time of the runs that finished in each interval.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (name) (increase(argo_workflows_workflowtemplate_runtime_sum{name=~\"$template\"}[$__interval])) / sum by (name) (increase(argo_workflows_workflowtemplate_runtime_count{name=~\"$template\"}[$__interval]))",
          "refId": "A",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "id": 13
    },
    {
      "type": "row",
      "title": "Pods",
      "collapsed": false,
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Workflow pods, by phase",
      "description": "Pods the workflow controller runs (not Spark's own driver and executor pods).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum by (phase) (argo_workflows_pods_gauge)",
          "refId": "A",
          "legendFormat": "{{phase}}",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 7
      },
      "id": 15
    },
    {
      "type": "row",
      "title": "Cost",
      "collapsed": false,
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cost this month",
      "description": "Azure cost of the project's resource groups so far this month (Cost Management, updated daily; the latest day is often incomplete).",
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lichess-api"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://chess-api.chess-api.svc.cluster.local/internal/v1/costs?months=1",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "date",
              "text": "Date",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "Service",
              "type": "string"
            },
            {
              "selector": "cost",
              "text": "Cost",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^Cost$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lichess-api"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 4,
        "h": 8
      },
      "id": 17
    },
    {
