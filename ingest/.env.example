# Copy to .env (never commit it) and fill in.

# Where raw Parquet + manifests go.
LICHESS_DEST=abfss://<container>@<account>.dfs.core.windows.net/bootstrap

# Credentials (pick one).
# 1) User-delegation SAS for the container (works in Docker; max 7 days), from:
#    az storage container generate-sas --account-name <account> --name <container> \
#      --permissions racwdl --expiry <YYYY-MM-DD> --auth-mode login --as-user -o tsv
AZURE_STORAGE_SAS_TOKEN=
# 2) Or a service principal (DefaultAzureCredential reads these):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
